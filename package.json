{
  "name": "psu-research-partnerships",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Penn State Research Partnerships — industry × faculty matchmaking with human review.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --import tsx server/standalone.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "reset-data": "node --disable-warning=ExperimentalWarning --import tsx server/cli/reset.ts",
    "sync": "node --disable-warning=ExperimentalWarning --import tsx server/cli/sync.ts",
    "ingest": "node --disable-warning=ExperimentalWarning --import tsx server/cli/ingest.ts",
    "eval": "node --disable-warning=ExperimentalWarning --import tsx server/cli/eval.ts",
    "matcher:check": "node --disable-warning=ExperimentalWarning --import tsx server/cli/matcher-check.ts",
    "users": "node --disable-warning=ExperimentalWarning --import tsx server/cli/users.ts",
    "apikey": "node --disable-warning=ExperimentalWarning --import tsx server/cli/apikey.ts",
    "backup": "node --disable-warning=ExperimentalWarning --import tsx server/cli/backup.ts",
    "check": "npm run typecheck && npm test && npm run matcher:check",
    "preview": "NODE_ENV=production ALLOW_DEV_AUTH=1 node --disable-warning=ExperimentalWarning --import tsx server/standalone.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
